APP_NAME=SkillWatch AI
APP_VERSION=0.1.0
CAMERA_SOURCE=device
CAMERA_INDEX=0
CONFIDENCE_THRESHOLD=0.5
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/skillwatch
SKILLWATCH_RECOGNITION_THRESHOLD=0.45
SKILLWATCH_RECOGNITION_CONFIRMATION_FRAMES=3
SKILLWATCH_RECOGNITION_SWITCH_FRAMES=3
SKILLWATCH_RECOGNITION_SWITCH_MARGIN=0.05
SKILLWATCH_INFRA_CONFIDENCE=0.30
SKILLWATCH_INFRA_NMS=0.45
SKILLWATCH_INFRA_ALERT_CONFIRMATION_FRAMES=5

# Phase 11: Remote event synchronization is OFF unless a receiver URL is set.
# Receiver must accept POST JSON {event_id, event_type, created_at, payload}
# and deduplicate by event_id (Idempotency-Key header). Prefer HTTPS.
# SKILLWATCH_SYNC_URL=https://your-trusted-server.example/api/events
# SKILLWATCH_SYNC_TOKEN=replace-with-a-secret-token
